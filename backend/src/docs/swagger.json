{
  "openapi": "3.0.0",
  "info": {
    "title": "API de Agendamentos e Gestão",
    "version": "1.0.0",
    "description": "Documentação da API RESTful com autenticação JWT e rotas protegidas para agendamentos médicos."
  },
  "servers": [
    {
      "url": "http://localhost:3000/api",
      "description": "Servidor de Desenvolvimento (Docker)"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Insira o token JWT obtido no login no formato: Bearer <seu_token>"
      }
    }
  },
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/users": {
      "post": {
        "summary": "Registar um novo utilizador",
        "tags": ["Utilizadores"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "nome": { "type": "string", "example": "Neuso" },
                  "email": { "type": "string", "example": "neuso@email.com" },
                  "password": { "type": "string", "example": "123456" }
                },
                "required": ["nome", "email", "password"]
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Utilizador criado com sucesso" },
          "400": { "description": "Erro nos dados enviados" }
        }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "Autenticar utilizador e gerar token JWT",
        "tags": ["Autenticação"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string", "example": "neuso@email.com" },
                  "password": { "type": "string", "example": "123456" }
                },
                "required": ["email", "password"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login efetuado com sucesso, retorna o token"
          },
          "401": { "description": "Credenciais inválidas" }
        }
      }
    },
    "/auth/profile": {
      "get": {
        "summary": "Obter perfil do utilizador autenticado (Rota Protegida)",
        "tags": ["Autenticação"],
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "description": "Dados do utilizador retornado com sucesso" },
          "401": { "description": "Não autorizado (Token ausente ou inválido)" }
        }
      }
    },
    "/agendamentos": {
      "get": {
        "summary": "Listar todos os agendamentos (Rota Protegida)",
        "tags": ["Agendamentos"],
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Lista de agendamentos retornada com sucesso"
          },
          "401": { "description": "Não autorizado (Token ausente ou inválido)" }
        }
      },
      "post": {
        "summary": "Criar um novo agendamento (Rota Protegida)",
        "tags": ["Agendamentos"],
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "paciente": { "type": "string", "example": "Maria Silva" },
                  "profissional": {
                    "type": "string",
                    "example": "Dr. Carlos Mendes"
                  },
                  "data_horario": {
                    "type": "string",
                    "format": "date-time",
                    "example": "2026-10-15T14:30:00.000Z"
                  }
                },
                "required": ["paciente", "profissional", "data_horario"]
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Agendamento criado com sucesso" },
          "401": { "description": "Não autorizado" }
        }
      }
    },
    "/agendamentos/{id}": {
      "get": {
        "summary": "Obter agendamento por ID (Rota Protegida)",
        "tags": ["Agendamentos"],
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID do agendamento",
            "schema": { "type": "integer", "example": 1 }
          }
        ],
        "responses": {
          "200": { "description": "Agendamento encontrado com sucesso" },
          "404": { "description": "Agendamento não encontrado" },
          "401": { "description": "Não autorizado" }
        }
      },
      "put": {
        "summary": "Atualizar agendamento por ID (Rota Protegida)",
        "tags": ["Agendamentos"],
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID do agendamento",
            "schema": { "type": "integer", "example": 1 }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "paciente": {
                    "type": "string",
                    "example": "Maria Silva Atualizada"
                  },
                  "profissional": {
                    "type": "string",
                    "example": "Dr. Carlos Mendes"
                  },
                  "data_horario": {
                    "type": "string",
                    "format": "date-time",
                    "example": "2026-10-15T15:00:00.000Z"
                  },
                  "status": { "type": "string", "example": "Realizado" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Agendamento atualizado com sucesso" },
          "404": { "description": "Agendamento não encontrado" },
          "401": { "description": "Não autorizado" }
        }
      },
      "delete": {
        "summary": "Remover agendamento por ID (Rota Protegida)",
        "tags": ["Agendamentos"],
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID do agendamento",
            "schema": { "type": "integer", "example": 1 }
          }
        ],
        "responses": {
          "200": { "description": "Agendamento removido com sucesso" },
          "404": { "description": "Agendamento não encontrado" },
          "401": { "description": "Não autorizado" }
        }
      }
    }
  }
}
